NODE_ENV=development
PORT=3000

# Base de datos
DB_HOST=localhost
DB_PORT=5438
DB_USER=postgres
DB_PASSWORD=pon-aqui-tu-password
DB_NAME=fleetcore_db
DB_SYNC=true

# JWT (el secreto debe tener 32 caracteres o mas)
JWT_SECRET=pon-aqui-un-secreto-largo-de-32-caracteres-o-mas
JWT_EXPIRES_IN=3600

# Usuario administrador que crea el seed
ADMIN_EMAIL=admin@fleetcore.com
ADMIN_PASSWORD=Admin12345

# Claves para integraciones externas (cabecera x-api-key), separadas por coma
API_KEYS=demo-key-partner-1,demo-key-partner-2
